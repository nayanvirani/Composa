{
	frankenphp
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /app/public
	encode zstd br gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Fingerprinted build assets can be cached forever.
	@build path /build/* /css/filament/* /js/filament/* /fonts/filament/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	php_server
}

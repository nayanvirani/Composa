{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && npm run build:storefront",
        "dev": "vite",
        "build:storefront": "node storefront/build.mjs",
        "test:engine": "node --test engine/js/test/engine.test.js engine/js/test/formula.test.js",
        "snapshot:engine": "node engine/js/scripts/snapshot.mjs",
        "test:functions": "node --test extensions/composa-cart-transform/test/ extensions/composa-price-fallback/test/",
        "test": "npm run test:engine && npm run test:functions",
        "dev:storefront": "node storefront/build.mjs --watch"
    },
    "dependencies": {
        "@inertiajs/react": "^2.1.0",
        "@shopify/polaris": "^13.9.5",
        "@shopify/polaris-icons": "^9.3.1",
        "axios": "^1.20.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^5.0.0",
        "esbuild": "^0.25.0",
        "laravel-vite-plugin": "^3.1",
        "preact": "^10.27.0",
        "vite": "^8.0.0"
    }
}

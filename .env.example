APP_NAME=Composa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public https URL of the app (Railway domain). Shopify, the App Proxy and webhooks point here.
APP_URL=https://composa.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Shopify (Partner Dashboard → Apps → Composa) -------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_APP_HANDLE=composa
SHOPIFY_SCOPES=read_products,write_products,read_themes,write_cart_transforms,read_orders,write_orders,write_files,read_locales,read_markets
SHOPIFY_PROXY_PREFIX=apps
SHOPIFY_PROXY_SUBPATH=composa
SHOPIFY_CART_TRANSFORM_HANDLE=composa-cart-transform
SHOPIFY_DISCOUNT_FUNCTION_HANDLE=composa-price-fallback
SHOPIFY_THEME_EXTENSION_HANDLE=composa-theme
# Leave false: only set true if the week-1 spike shows lineExpand into the line's own variant is refused.
COMPOSA_FORCE_DISCOUNT_FALLBACK=false

# ---- Database: PostgreSQL on Railway (fill in later) -----------------------------------------
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Or a single Railway connection string:
# DB_URL=postgresql://user:password@host:5432/railway

# ---- Redis on Railway: cache, sessions, queues (Horizon) ------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379
# REDIS_URL=redis://default:password@host:6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ---- Files: Railway Storage Bucket (S3-compatible, private) ----------------------------------
FILESYSTEM_DISK=local
COMPOSA_UPLOAD_DISK=s3
COMPOSA_UPLOAD_MAX_MB=20
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# ---- Super admin ------------------------------------------------------------------------------
# Optional separate subdomain, e.g. admin.composa.app (leave empty to serve /admin on APP_URL).
ADMIN_DOMAIN=
ADMIN_PATH=admin
ADMIN_GOOGLE_SSO=false
ADMIN_ALLOWED_EMAIL_DOMAINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/admin/auth/google/callback"

# ---- Mail -------------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Monitoring -------------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_DSN=

VITE_APP_NAME="${APP_NAME}"
VITE_SHOPIFY_API_KEY="${SHOPIFY_API_KEY}"
